{
    "name": "epixel/licence-guard",
    "description": "Checks a signed licence file before a Laravel application opens.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Epixel\\LicenceGuard\\": "src/"
        },
        "files": [
            "gate.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Epixel\\LicenceGuard\\LicenceServiceProvider"
            ]
        }
    }
}
